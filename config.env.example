# ═══════════════════════════════════════════════════════════════════════════════
#  Termux & PC Media Processing Pipeline - Configuration File
# ═══════════════════════════════════════════════════════════════════════════════
#  This file stores user configuration and overrides.
#  It is never overwritten by Git updates.
# ═══════════════════════════════════════════════════════════════════════════════

# Target integrated loudness in LUFS (Default: -9)
# Uses pure constant linear gain with zero dynamic range compression (DRC).
TARGET_LUFS="-9"

# Maximum True-Peak limit in dBTP (Default: -0.5)
# Protects against inter-sample/digital clipping by capping constant linear gain.
# Retains natural dynamics and relative volume differences without any limiter pumping.
MAX_TRUE_PEAK="-0.5"

# Audio bitrate for normalized AAC stream (Default: 192k)
AUDIO_BITRATE="192k"

# Maximum log file size in bytes before 50% oldest data rotation (Default: 2097152 = 2 MB)
LOG_MAX_BYTES="2097152"

# Custom root media directory
# Android Termux Default: /storage/emulated/0
# PC Default:             ~/TermuxMedia
# Uncomment to override:
# MEDIA_DIR="/storage/emulated/0"

# Web UI Listening Host & Port
# Use 127.0.0.1 for local device only, 0.0.0.0 to access from other devices on your LAN.
WEB_UI_HOST="0.0.0.0"
WEB_UI_PORT="8080"

# Automatically check and update yt-dlp on pipeline runs (true / false)
AUTO_UPDATE_YTDLP="true"
